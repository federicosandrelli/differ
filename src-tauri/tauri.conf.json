{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "differ",
  "version": "0.1.0",
  "identifier": "com.federicosandrelli.differ",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": {
      "../*.py": "python/",
      "../page/*": "python/page/",
      "../shell/*": "python/shell/"
    }
  }
}
