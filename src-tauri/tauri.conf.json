{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "differ",
  "version": "0.1.0",
  "identifier": "com.federicosandrelli.differ",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": {
      "../server.py": "python/server.py",
      "../build.py": "python/build.py",
      "../classify.py": "python/classify.py",
      "../render.py": "python/render.py",
      "../page.css": "python/page.css",
      "../page.js": "python/page.js"
    }
  }
}
