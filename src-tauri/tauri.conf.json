{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "differ",
  "version": "0.1.0",
  "identifier": "com.federicosandrelli.differ",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:*; script-src 'self' 'unsafe-inline' http://127.0.0.1:*; style-src 'self' 'unsafe-inline' http://127.0.0.1:*; img-src * data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": {
      "../*.py": "python/",
      "../page/*": "python/page/",
      "../page/vendor/*": "python/page/vendor/",
      "../shell/*": "python/shell/"
    }
  }
}
