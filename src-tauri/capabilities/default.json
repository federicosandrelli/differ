{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window, including the pages it loads from the local review server",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*"] },
  "permissions": ["core:default", "core:window:allow-set-theme", "core:window:allow-theme", "core:window:allow-start-dragging"]
}
